module

public import CompStark.Keccak.GkrProver.LatePack

/-! Structural decomposition of the complete production layer transition. -/

set_option maxRecDepth 32768
set_option maxHeartbeats 1000000

@[expose] public section
namespace CompStark.Keccak.GkrProver
open BF64

/-- The complete indexed pack transition, including the fourth-coordinate table materialization. -/
def nativePackStep (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (state : PackResult) (i : Nat) : PackResult :=
  let coefficients := if i < 4 then (earlyRound early claim.point state.point).map (state.scale*·)
    else packRoundFromClaim state.table claim.weights (packConstants claim.weights (sum (instanceWeights s)))
      (eqTable (claim.point.extract (i+1) claim.point.size)) claim.point[i]! state.scale state.value
  let message := #[coefficients[1]!,coefficients[2]!]
  let (r,writer) := (state.writer.writeAll message).sample
  let point := state.point.push r
  let table := if i = 3 then packedTable w d (instanceWeights s) point
    else if 4 ≤ i then foldPacked state.table 1600 r else state.table
  ⟨table,state.scale*(1+claim.point[i]!+r),
    (1+claim.point[i]!+r)*(coefficients[0]!+r*(coefficients[1]!+r*coefficients[2]!)),
    point,state.messages.push message,writer⟩

/-- The production pack loop expressed as a structural fold of its exact indexed transitions. -/
def nativePackRun (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (writer : Writer) (value : W) : PackResult :=
  (List.range claim.point.size).foldl (nativePackStep w d claim s early)
    ⟨PackedE.zeros 0,lane 1,value,#[],#[],writer⟩

/-- Every indexed production pack transition appends exactly one point and one message. -/
theorem nativePackStep_lengths (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (state : PackResult) (i : Nat) :
    (nativePackStep w d claim s early state i).point.size = state.point.size+1 ∧
      (nativePackStep w d claim s early state i).messages.size = state.messages.size+1 :=
  ⟨Array.size_push ..,Array.size_push ..⟩

/-- Any structural prefix of production pack transitions appends exactly its own number of rounds. -/
theorem nativePackFold_lengths (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (indices : List Nat) (state : PackResult) :
    (indices.foldl (nativePackStep w d claim s early) state).point.size = state.point.size+indices.length ∧
      (indices.foldl (nativePackStep w d claim s early) state).messages.size = state.messages.size+indices.length := by
  induction indices generalizing state with
  | nil => simp only [List.foldl_nil,List.length_nil,Nat.add_zero,and_self]
  | cons i indices ih =>
    rw [List.foldl_cons]
    have hh := ih (nativePackStep w d claim s early state i)
    rw [(nativePackStep_lengths w d claim s early state i).1] at hh
    rw [(nativePackStep_lengths w d claim s early state i).2] at hh
    simpa only [List.length_cons,Nat.add_assoc,Nat.add_comm 1] using hh

/-- The complete production pack run has exactly the entering claim's number of coordinates and messages. -/
theorem nativePackRun_lengths (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (writer : Writer) (value : W) :
    (nativePackRun w d claim s early writer value).point.size = claim.point.size ∧
      (nativePackRun w d claim s early writer value).messages.size = claim.point.size := by
  simpa only [nativePackRun,List.length_range,Array.size_empty,Nat.zero_add] using
    nativePackFold_lengths w d claim s early (List.range claim.point.size)
      ⟨PackedE.zeros 0,lane 1,value,#[],#[],writer⟩

/-- Mutable tuple used by the elaborated production pack loop. -/
abbrev PackTuple := Writer × W × PackedE × W × Array W × Array (Array W)

/-- Preserve all pack-state fields in the production loop's mutable-variable order. -/
def PackResult.toTuple (state : PackResult) : PackTuple :=
  (state.writer,state.value,state.table,state.scale,state.point,state.messages)

/-- The exact mutable-variable transition generated by the production pack loop. -/
def nativePackTupleStep (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (state : PackTuple) (i : Nat) : PackTuple :=
  let coefficients := if i < 4 then (earlyRound early claim.point state.2.2.2.2.1).map (state.2.2.2.1*·)
    else packRoundFromClaim state.2.2.1 claim.weights (packConstants claim.weights (sum (instanceWeights s)))
      (eqTable (claim.point.extract (i+1) claim.point.size)) claim.point[i]! state.2.2.2.1 state.2.1
  let message := #[coefficients[1]!,coefficients[2]!]
  let (r,writer) := (state.1.writeAll message).sample
  let value := (1+claim.point[i]!+r)*(coefficients[0]!+r*(coefficients[1]!+r*coefficients[2]!))
  let scale := state.2.2.2.1*(1+claim.point[i]!+r)
  let point := state.2.2.2.2.1.push r
  let messages := state.2.2.2.2.2.push message
  if i = 3 then (writer,value,packedTable w d (instanceWeights s) point,scale,point,messages)
  else if 4 ≤ i then (writer,value,foldPacked state.2.2.1 1600 r,scale,point,messages)
  else (writer,value,state.2.2.1,scale,point,messages)

/-- A structural pack transition preserves all fields of the production mutable tuple. -/
theorem nativePackTupleStep_eq (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (state : PackResult) (i : Nat) :
    nativePackTupleStep w d claim s early state.toTuple i =
      (nativePackStep w d claim s early state i).toTuple := by
  dsimp only [nativePackTupleStep,nativePackStep,PackResult.toTuple]
  split <;> split <;> rfl

/-- Structural and production pack folds retain exactly the same complete tuple state. -/
theorem nativePackRun_tuple (w : SlicedWitness) (d : Nat) (claim : Claim) (s : W) (early : Array W)
    (writer : Writer) (value : W) :
    (List.range claim.point.size).foldl (nativePackTupleStep w d claim s early)
      (writer,value,PackedE.zeros 0,lane 1,#[],#[]) =
        (nativePackRun w d claim s early writer value).toTuple := by
  unfold nativePackRun
  apply List.foldl_hom PackResult.toTuple (init := ⟨PackedE.zeros 0,lane 1,value,#[],#[],writer⟩)
  exact nativePackTupleStep_eq w d claim s early

/-- Position-loop fields in their order in the production layer's mutable tuple. -/
def PositionResult.toLayerTuple (state : PositionResult) :
    Writer × Array (Array W) × Array W × Array W × Array (Array W) :=
  (state.writer,state.factors,state.weights,state.point,state.messages)

/-- The normalized production position transition in its layer-loop tuple order. -/
def positionLayerTupleStep (scale kappa : W)
    (state : Writer × Array (Array W) × Array W × Array W × Array (Array W)) (_i : Nat) :=
  let message := (positionRound state.2.2.1 state.2.1 kappa).map (scale*·)
  let (r,writer) := (state.1.writeAll message).sample
  (writer,state.2.1.map (fun a => fold a 1 r),fold state.2.2.1 1 r,
    state.2.2.2.1.push r,state.2.2.2.2.push message)

/-- The production layer's position tuple fold is the exact structural position run. -/
theorem positionRun_layerTuple (writer : Writer) (weights : Array W) (factors : Array (Array W))
    (scale kappa : W) (n : Nat) :
    (List.range n).foldl (positionLayerTupleStep scale kappa) (writer,factors,weights,#[],#[]) =
      (positionRun scale kappa ⟨weights,factors,#[],#[],writer⟩ n).toLayerTuple := by
  rw [positionRun_eq_fold]
  apply List.foldl_hom PositionResult.toLayerTuple (init := ⟨weights,factors,#[],#[],writer⟩)
  intro state i
  rfl

/-- Construct the full layer from its pack run, position run and beta-batched terminal evaluations. -/
def layerFromRuns (writer : Writer) (w : SlicedWitness) (d : Nat) (claim : Claim)
    (products : RmfeProducts) : Layer × Claim × Writer :=
  let prod := product w d claim products
  let (s,writer) := (writer.writeAll prod.message).sample
  let mu := instanceWeights s
  let kappa := sum mu
  let challenge := CompStark.Sumcheck.prepare s
  let maps := prepareWeightMaps claim.weights challenge
  let early := earlyValues w d claim maps products (binaryValues prod.packs claim.point challenge)
  let pack := nativePackRun w d claim s early writer (evaluate prod.message s)
  let factors := Array.ofFn fun k : Fin 3 => Array.ofFn fun j : Fin 2048 =>
    if j.val < 1600 then pack.table.get (shift j.val k.val) else lane 0
  let pos := positionLoop pack.writer (claim.weights++Array.replicate 448 0) factors pack.scale kappa 11
  let evaluations := pos.factors.map (·[0]!)
  let (beta,writer) := (pos.writer.writeAll evaluations).sample
  let eq := eqTable pos.point
  let chi := Array.ofFn fun j : Fin 1600 =>
    eq[j.val]!+beta*eq[shift j.val 4]!+(beta*beta)*eq[shift j.val 3]!
  (⟨prod.message,s,pack.messages,pack.point,pos.messages,pos.point,evaluations,beta⟩,
    ⟨evaluations[0]!+beta*(evaluations[1]!+beta*evaluations[2]!),mu,pack.point,transposeWeights chi⟩,writer)

attribute [local irreducible] product Writer.sample Writer.writeAll instanceWeights sum
  evaluate earlyValues binaryValues prepareWeightMaps packedTable eqTable earlyRound packRoundFromClaim
  packConstants foldPacked positionRound fold foldArrayShared transposeWeights

/-- The phase-observer-free production layer is exactly its structural pack, position and batching decomposition. -/
theorem proveLayerM_eq_runs (writer : Writer) (w : SlicedWitness) (d : Nat) (claim : Claim)
    (products : RmfeProducts) :
    Id.run (proveLayerM (M := Id) (fun _ _ => pure ()) writer w d claim products) =
      layerFromRuns writer w d claim products := by
  have hbind {A B : Type} (a : Id A) (f : A → Id B) : a >>= f = f a := rfl
  have hpure {A : Type} (a : A) : (pure a : Id A) = a := rfl
  simp only [proveLayerM,layerFromRuns,
    hbind,Std.Legacy.Range.forIn_eq_forIn_range',ite_pure_yield,List.forIn_pure_yield_eq_foldl,Id.run_pure,
    Std.Legacy.Range.size,Nat.sub_zero,Nat.add_sub_cancel,Nat.div_one,← List.range_eq_range']
  simp only [hpure]
  set prod := product w d claim products
  generalize hs : (writer.writeAll prod.message).sample = sampled
  generalize he : earlyValues w d claim (prepareWeightMaps claim.weights (CompStark.Sumcheck.prepare sampled.1))
    products (binaryValues prod.packs claim.point (CompStark.Sumcheck.prepare sampled.1)) = early
  have hp := nativePackRun_tuple w d claim sampled.1 early sampled.2 (evaluate prod.message sampled.1)
  unfold nativePackTupleStep at hp
  rw [hp]
  simp only [PackResult.toTuple,foldArrayShared_eq,ite_self]
  set pack := nativePackRun w d claim sampled.1 early sampled.2 (evaluate prod.message sampled.1)
  set factors := Array.ofFn (fun k : Fin 3 => Array.ofFn fun j : Fin 2048 =>
    if j.val < 1600 then pack.table.get (shift j.val k.val) else lane 0)
  set weights := claim.weights++Array.replicate 448 0
  have hpos := positionRun_layerTuple pack.writer weights factors pack.scale (sum (instanceWeights sampled.1)) 11
  unfold positionLayerTupleStep at hpos
  rw [hpos]
  simp only [PositionResult.toLayerTuple]
  rw [positionLoop_eq_run]

end CompStark.Keccak.GkrProver
