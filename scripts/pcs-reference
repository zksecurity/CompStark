#!/usr/bin/env python3
"""Build an external read-only driver of the pinned leanMultisig PCS kernels."""
from pathlib import Path
import os
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
REVISION = '9d8bce818aa7c7e18e67026e522a9b1539d0a57d'

def main():
    source = Path(sys.argv[1]).resolve()
    output = Path(sys.argv[2]).resolve()
    assert subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip() == REVISION
    assert not subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain', '--untracked-files=no'], text=True).strip()
    with tempfile.TemporaryDirectory(prefix='pcs-reference-') as directory:
        directory = Path(directory)
        crate = directory / 'pcs'
        shutil.copytree(source / 'crates/pcs/src', crate / 'src')
        dependencies = '\n'.join(f'{name} = {{path = "{source}/crates/{name}"}}'
                                 for name in ['parallel', 'primitives', 'fiat_shamir'])
        (crate / 'Cargo.toml').write_text('[package]\nname = "pcs"\nversion = "0.1.0"\nedition = "2024"\n[dependencies]\ntracing = "0.1.26"\n' + dependencies + '\n')
        with (crate / 'src/whir_induce.rs').open('a') as module:
            module.write(f'\npub mod pcs_induction_fixture {{ include!("{ROOT}/tests/rust/induction.rs"); }}\n')
        with (crate / 'src/lib.rs').open('a') as module:
            module.write('\npub use whir_induce::pcs_induction_fixture;\n')
        with (crate / 'src/whir.rs').open('a') as module:
            module.write(f'\npub mod pcs_accumulated_fixture {{ include!("{ROOT}/tests/rust/accumulated.rs"); }}\n')
        with (crate / 'src/lib.rs').open('a') as module:
            module.write('\npub use whir::pcs_accumulated_fixture;\n')
        shutil.copy2(source / 'Cargo.lock', directory / 'Cargo.lock')
        (directory / 'src').mkdir()
        (directory / 'Cargo.toml').write_text('[package]\nname = "pcs-reference"\nversion = "0.1.0"\nedition = "2024"\n[dependencies]\n' + '\n'.join(f'{name} = {{path = "{source}/crates/{name}"}}' for name in ['primitives']) + f'\npcs = {{path = "{crate}"}}\n')
        (directory / 'src/main.rs').write_text((ROOT / 'tests/rust/pcs.rs').read_text())
        subprocess.run(['cargo', 'build', '--release', '--manifest-path', str(directory / 'Cargo.toml'), '-j', '4'], check=True,
                       env={**os.environ, 'CARGO_TARGET_DIR': str(output), 'RUSTFLAGS': '-C target-cpu=native'})
    assert not subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain', '--untracked-files=no'], text=True).strip()
    print(output / 'release/pcs-reference')

if __name__ == '__main__':
    main()
