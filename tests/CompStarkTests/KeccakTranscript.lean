/-- Bytecode input for the cross-language seed vector. -/
def bytecode : ByteArray := ⟨#[0, 1, 2, 255]⟩

/-- Public statement bytes 0 through 31. -/
def publicInput : Digest := ⟨Array.ofFn (fun i : Fin 32 ↦ i.val.toUInt8), by simp⟩

/-- Polynomial-basis limbs of a sampled E element. -/
def limbs (x : E) : List UInt64 := [laneWord (x.limb 0), laneWord (x.limb 1), laneWord (x.limb 2)]

/-- The Rust crate's distinctive scalar pattern. -/
def pattern (k : ℕ) : E :=
  E.ofLimbs (K.ofBits k) (K.ofBits (Nat.xor k 0x1234)) (K.ofBits (k * 2^17))

/-- Seeded state with `n` transmitted pattern scalars, including automatic fifth-item flushes. -/
def observed (n : ℕ) : State :=
  absorbAll (seed bytecode publicInput) ((List.range n).map fun k ↦ .scalar (pattern (k + 1)))


/-- Full height-three leaf images, with a single omitted zero prefix word. -/
def image (p : ℕ) : List K := [0, K.ofBits (4*p+1), K.ofBits (4*p+2), K.ofBits (4*p+3)]

