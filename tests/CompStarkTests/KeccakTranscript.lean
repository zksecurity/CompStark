/-- Check every Rust vector compiled; the Keccak permutation runs on the packed native kernels. -/
def check : IO Unit := do
  for (line, ok) in vectors do
    unless ok do throw (IO.userError s!"Keccak transcript vector at line {line} differs from Rust")
  IO.println s!"Keccak duplex transcript and Merkle openings: {vectors.length} Rust vectors match"

end
