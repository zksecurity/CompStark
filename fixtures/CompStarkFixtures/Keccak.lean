import CompStark.Stark.Air
import CompPoly.Univariate.NTTFast.Packed.Native

/-! # Plonky3's Keccak AIR

Plonky3's `KeccakAir` (`keccak-air` at revision `a4982ec`) as a CompStark AIR, constraint for
constraint in Plonky3's emission order, and its trace generator. A fixture of the tests and
benchmarks, not part of the library: its fingerprint matches Plonky3's (`tests/data`).

The trace has 2633 columns and proves one Keccak-f permutation per 24 rows, one round per row:
the round flags, the export flag, the preimage and the round's input `A` as 16-bit limbs, the
column parities `C` and `C'` as bits, `A'` after θ as bits, `A''` after ρ, π and χ as limbs, the
bits of `A''[0, 0]`, and the limbs of `A'''[0, 0]` after ι. Lanes are indexed `y`-major, as in
Plonky3's `KeccakCols`.

`trace` is Plonky3's `generate_trace_rows`: `(24 · #inputs).nextPowerOfTwo` rows, the padding
permutations of the all-zero input, the last one cut off; as packed Montgomery words, row-major,
in chunks of consecutive rows generated by parallel tasks.
-/

namespace CompStark.Fixtures.Keccak
open CompStark.Stark

/-- The rotation offsets `R[x][y]`. -/
def R : Array (Array Nat) := #[#[0, 36, 3, 41, 18], #[1, 44, 10, 45, 2], #[62, 6, 43, 15, 61],
  #[28, 55, 25, 21, 56], #[27, 20, 39, 8, 14]]

/-- The round constants. -/
def RC : Array UInt64 := #[0x0000000000000001, 0x0000000000008082, 0x800000000000808A,
  0x8000000080008000, 0x000000000000808B, 0x0000000080000001, 0x8000000080008081,
  0x8000000000008009, 0x000000000000008A, 0x0000000000000088, 0x0000000080008009,
  0x000000008000000A, 0x000000008000808B, 0x800000000000008B, 0x8000000000008089,
  0x8000000000008003, 0x8000000000008002, 0x8000000000000080, 0x000000000000800A,
  0x800000008000000A, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001,
  0x8000000080008008]

/-! ### Columns -/

/-- The export flag. -/
def exportCol : Nat := 24
/-- Limb `l` of lane `(x, y)` of the preimage. -/
def preimageCol (y x l : Nat) : Nat := 25 + (y * 5 + x) * 4 + l
/-- Limb `l` of lane `(x, y)` of the round's input `A`. -/
def aCol (y x l : Nat) : Nat := 125 + (y * 5 + x) * 4 + l
/-- Bit `z` of `C[x]`. -/
def cCol (x z : Nat) : Nat := 225 + x * 64 + z
/-- Bit `z` of `C'[x]`. -/
def cPrimeCol (x z : Nat) : Nat := 545 + x * 64 + z
/-- Bit `z` of lane `(x, y)` of `A'`. -/
def aPrimeCol (y x z : Nat) : Nat := 865 + (y * 5 + x) * 64 + z
/-- Limb `l` of lane `(x, y)` of `A''`. -/
def aPrimePrimeCol (y x l : Nat) : Nat := 2465 + (y * 5 + x) * 4 + l
/-- Bit `z` of `A''[0, 0]`. -/
def aPrimePrime00BitCol (z : Nat) : Nat := 2565 + z
/-- Limb `l` of `A'''[0, 0]`. -/
def aPrimePrimePrime00Col (l : Nat) : Nat := 2629 + l
/-- The trace's width. -/
def width : Nat := 2633

/-- Bit `z` of lane `(x, y)` of `B`, which is `A'` rotated (Plonky3's `b`). -/
def bCol (x y z : Nat) : Nat :=
  let a := (x + 3 * y) % 5
  let rot := (R.getD a #[]).getD x 0
  aPrimeCol x a ((z + 64 - rot) % 64)

/-- Limb `l` of lane `(x, y)` of `A'''`: `A''`, except at `(0, 0)`. -/
def aPrimePrimePrimeCol (y x l : Nat) : Nat :=
  if y = 0 ∧ x = 0 then aPrimePrimePrime00Col l else aPrimePrimeCol y x l

/-! ### Constraints -/

variable {F : Type} [NatCast F]

def c (n : Nat) : Expr F := .const (n : F)
def cur (i : Nat) : Expr F := .cur i
def nxt (i : Nat) : Expr F := .next i
/-- Plonky3's `xor` of two bits. -/
def xor (a b : Expr F) : Expr F := a + b - a * (c 2 * b)
/-- Plonky3's `andn` of two bits. -/
def andn (a b : Expr F) : Expr F := (c 1 - a) * b
/-- Plonky3's `assert_bool`. -/
def boolCheck (x : Expr F) : Expr F := x * (x - c 1)
/-- `Σ bit(16 limb + i) 2^i` over a limb's 16 bits, by Horner from the top bit (Plonky3's
`pack_bits_le`). -/
def limbOf (bit : Nat → Expr F) (limb : Nat) : Expr F :=
  (List.range 15).foldl (fun acc k ↦ c 2 * acc + bit (limb * 16 + 14 - k)) (bit (limb * 16 + 15))

/-- `f i j` for `i, j < 5`, `i` outer. -/
def grid {α : Type} (f : Nat → Nat → List α) : List α :=
  (List.range 5).flatMap fun i ↦ (List.range 5).flatMap fun j ↦ f i j
/-- `f l` for the four limbs. -/
def limbs {α : Type} (f : Nat → α) : List α := (List.range 4).map f

/-- The constraints, in Plonky3's order. -/
def constraints : List (Expr F) :=
  let notLast : Expr F := .isTransition * (c 1 - cur 23)
  let flags := [.isFirstRow * (cur 0 - c 1)] ++
    (List.range 23).map (fun i ↦ .isFirstRow * cur (i + 1)) ++
    (List.range 24).map fun i ↦ .isTransition * (cur i - nxt ((i + 1) % 24))
  let firstPreimage := grid fun y x ↦ limbs fun l ↦
    cur 0 * (cur (preimageCol y x l) - cur (aCol y x l))
  let samePreimage := grid fun y x ↦ limbs fun l ↦
    notLast * (cur (preimageCol y x l) - nxt (preimageCol y x l))
  let exportFlag := [boolCheck (cur exportCol), (c 1 - cur 23) * cur exportCol]
  let cs := (List.range 5).flatMap fun x ↦
    (List.range 64).map (fun z ↦ boolCheck (cur (cCol x z))) ++
    (List.range 64).map fun z ↦ cur (cPrimeCol x z) -
      xor (xor (cur (cCol x z)) (cur (cCol ((x + 4) % 5) z)))
        (cur (cCol ((x + 1) % 5) ((z + 63) % 64)))
  let aPrimes := (List.range 5).flatMap fun x ↦
    let cxc (z : Nat) : Expr F := xor (cur (cCol x z)) (cur (cPrimeCol x z))
    (List.range 5).flatMap fun y ↦
      (List.range 64).map (fun z ↦ boolCheck (cur (aPrimeCol y x z))) ++
      limbs fun l ↦ limbOf (fun z ↦ xor (cur (aPrimeCol y x z)) (cxc z)) l - cur (aCol y x l)
  let parity := (List.range 5).flatMap fun x ↦ (List.range 64).map fun z ↦
    let sum := (List.range 4).foldl (fun s y ↦ s + cur (aPrimeCol (y + 1) x z))
      (cur (aPrimeCol 0 x z))
    let diff := sum - cur (cPrimeCol x z)
    diff * (diff - c 2) * (diff - c 4)
  let chi := grid fun y x ↦ limbs fun l ↦
    limbOf (fun z ↦ xor (andn (cur (bCol ((x + 1) % 5) y z)) (cur (bCol ((x + 2) % 5) y z)))
      (cur (bCol x y z))) l - cur (aPrimePrimeCol y x l)
  let bits := (List.range 64).map (fun z ↦ boolCheck (cur (aPrimePrime00BitCol z))) ++
    limbs fun l ↦ limbOf (fun z ↦ cur (aPrimePrime00BitCol z)) l - cur (aPrimePrimeCol 0 0 l)
  let rcBit (i : Nat) : Expr F :=
    match (List.range 24).filter (fun r ↦ ((RC.getD r 0).toNat).testBit i) with
    | [] => c 0
    | r :: rs => rs.foldl (fun s r ↦ s + cur r) (cur r)
  let iota := limbs fun l ↦
    limbOf (fun z ↦ xor (rcBit z) (cur (aPrimePrime00BitCol z))) l - cur (aPrimePrimePrime00Col l)
  let output := (List.range 5).flatMap fun x ↦ (List.range 5).flatMap fun y ↦
    limbs fun l ↦ notLast * (cur (aPrimePrimePrimeCol y x l) - nxt (aCol y x l))
  flags ++ firstPreimage ++ samePreimage ++ exportFlag ++ cs ++ aPrimes ++ parity ++ chi ++ bits ++
    iota ++ output

/-- Plonky3's `KeccakAir`. -/
def air : Air F where
  width := width
  numPublicValues := 0
  constraints := constraints

/-! ### Trace generation -/

/-- `x` rotated left by `n < 64`. -/
@[inline] def rotl (x : UInt64) (n : Nat) : UInt64 :=
  (x <<< n.toUInt64) ||| (x >>> (64 - n).toUInt64)

/-- The Montgomery words of a field: of one, and of every 16-bit value. -/
structure Words where
  one : UInt32
  limbs : ByteArray

open CompPoly.CPolynomial.NTTFast.Packed.Native (read write write16U zeroWords generate) in
/-- The Montgomery words of `FastField p`. -/
def Words.of (p : Nat) [Montgomery.Native32.Mont32Field p] : Words :=
  ⟨(1 : Montgomery.Native32.FastField p).val,
    generate 65536 fun v ↦ ((v : Nat) : Montgomery.Native32.FastField p).val⟩

open CompPoly.CPolynomial.NTTFast.Packed.Native (read write write16U)

/-- The word of bit `z` of `x`: `one` or zero. -/
@[inline] def bitWord (one : UInt32) (x z : UInt64) : UInt32 := one * ((x >>> z) &&& 1).toUInt32

/-- Store bits `z, …, z + 15` of `x` as words `off, …, off + 15`. -/
@[inline] def writeBits16 (one : UInt32) (b : ByteArray) (off : Nat) (x z : UInt64) : ByteArray :=
  write16U b off.toUSize (bitWord one x z) (bitWord one x (z + 1)) (bitWord one x (z + 2))
    (bitWord one x (z + 3)) (bitWord one x (z + 4)) (bitWord one x (z + 5))
    (bitWord one x (z + 6)) (bitWord one x (z + 7)) (bitWord one x (z + 8))
    (bitWord one x (z + 9)) (bitWord one x (z + 10)) (bitWord one x (z + 11))
    (bitWord one x (z + 12)) (bitWord one x (z + 13)) (bitWord one x (z + 14))
    (bitWord one x (z + 15))

/-- Store the 64 bits of `x` as words `off, …, off + 63`. -/
@[inline] def writeBits (W : Words) (b : ByteArray) (off : Nat) (x : UInt64) : ByteArray :=
  let b := writeBits16 W.one b off x 0
  let b := writeBits16 W.one b (off + 16) x 16
  let b := writeBits16 W.one b (off + 32) x 32
  writeBits16 W.one b (off + 48) x 48

/-- The word of limb `l` of `x`. -/
@[inline] def limbWord (W : Words) (x : UInt64) (l : UInt64) : UInt32 :=
  read W.limbs ((x >>> (16 * l)) &&& 0xffff).toNat

/-- Store the four 16-bit limbs of `x`, lowest first, as words `off, …, off + 3`. -/
@[inline] def writeLimbs (W : Words) (b : ByteArray) (off : Nat) (x : UInt64) : ByteArray :=
  let b := write b off (limbWord W x 0)
  let b := write b (off + 1) (limbWord W x 1)
  let b := write b (off + 2) (limbWord W x 2)
  write b (off + 3) (limbWord W x 3)

/-- Lane `(x, y)` of a state indexed `5 x + y`. -/
@[inline] def lane (s : Array UInt64) (x y : Nat) : UInt64 := s.getD (5 * x + y) 0

/-- The values of round `r` on the state `s` (lanes `5 x + y`): `C`, `C'`, `A'`, `A''` and the
state after the round, `A'''`. -/
def roundValues (s : Array UInt64) (r : Nat) :
    Array UInt64 × Array UInt64 × Array UInt64 × Array UInt64 × Array UInt64 :=
  let cs := Array.ofFn (n := 5) fun x ↦
    lane s x 0 ^^^ lane s x 1 ^^^ lane s x 2 ^^^ lane s x 3 ^^^ lane s x 4
  let cps := Array.ofFn (n := 5) fun x ↦
    cs.getD x 0 ^^^ cs.getD ((x + 4) % 5) 0 ^^^ rotl (cs.getD ((x + 1) % 5) 0) 1
  let ap := Array.ofFn (n := 25) fun k ↦
    s.getD k 0 ^^^ cs.getD (k / 5) 0 ^^^ cps.getD (k / 5) 0
  let bs := Array.ofFn (n := 25) fun k ↦
    let i := k.val / 5
    let a := (i + 3 * (k.val % 5)) % 5
    rotl (lane ap a i) ((R.getD a #[]).getD i 0)
  let app := Array.ofFn (n := 25) fun k ↦
    let i := k.val / 5
    let j := k.val % 5
    lane bs i j ^^^ (~~~(lane bs ((i + 1) % 5) j) &&& lane bs ((i + 2) % 5) j)
  (cs, cps, ap, app, app.set! 0 (app.getD 0 0 ^^^ RC.getD r 0))

/-- Round `r` on the state `s` of the permutation of `s0`, written as the row at word `off` of
`b` (Plonky3's `generate_trace_row_for_round`); and the state after it. -/
def round (W : Words) (b : ByteArray) (off : Nat) (s0 s : Array UInt64) (r : Nat) :
    ByteArray × Array UInt64 :=
  let (cs, cps, ap, app, out) := roundValues s r
  Id.run do
    let mut b := write b (off + r) W.one
    for k in [0:25] do
      let (y, x) := (k / 5, k % 5)
      b := writeLimbs W b (off + preimageCol y x 0) (lane s0 x y)
      b := writeLimbs W b (off + aCol y x 0) (lane s x y)
      b := writeBits W b (off + aPrimeCol y x 0) (lane ap x y)
      b := writeLimbs W b (off + aPrimePrimeCol y x 0) (lane app x y)
    for x in [0:5] do
      b := writeBits W b (off + cCol x 0) (cs.getD x 0)
      b := writeBits W b (off + cPrimeCol x 0) (cps.getD x 0)
    b := writeBits W b (off + aPrimePrime00BitCol 0) (app.getD 0 0)
    return (writeLimbs W b (off + aPrimePrimePrime00Col 0) (out.getD 0 0), out)

/-- The rows of rounds `lo, …, hi - 1` of the permutation of `input` (Plonky3's indexing, lane
`(x, y)` at `x + 5 y`), written from word `off` of `b`. -/
def permutationRows (W : Words) (b : ByteArray) (off : Nat) (input : Array UInt64) (lo hi : Nat) :
    ByteArray := Id.run do
  let s0 := Array.ofFn (n := 25) fun k ↦ input.getD (k.val / 5 + 5 * (k.val % 5)) 0
  let mut s := s0
  let mut b := b
  for r in [0:hi] do
    if lo ≤ r then
      let (b', s') := round W b (off + (r - lo) * width) s0 s r
      b := b'
      s := s'
    else
      s := (roundValues s r).2.2.2.2
  return b

/-- The rows `start, …, start + len - 1` of the trace of `inputs` (padded with all-zero inputs) as
packed words. -/
def rows (W : Words) (inputs : Array (Array UInt64)) (start len : Nat) : ByteArray := Id.run do
  let mut b := CompPoly.CPolynomial.NTTFast.Packed.Native.zeroWords (len * width)
  let mut r := start
  while r < start + len do
    let perm := r / 24
    let hi := min 24 (start + len - 24 * perm)
    b := permutationRows W b ((r - start) * width)
      (inputs.getD perm #[]) (r % 24) hi
    r := 24 * perm + hi
  return b

/-- Plonky3's `generate_trace_rows` over `FastField p` as packed words, row-major, in `chunks`
chunks of consecutive rows generated in parallel: `(24 · #inputs).nextPowerOfTwo` rows. -/
def trace (p : Nat) [Montgomery.Native32.Mont32Field p] (inputs : Array (Array UInt64))
    (chunks : Nat) : Array ByteArray :=
  let W := Words.of p
  let n := (24 * inputs.size).nextPowerOfTwo
  let size := n / chunks
  let tasks := (Array.range chunks).map fun k ↦ Task.spawn fun _ ↦
    rows W inputs (k * size) (if k + 1 = chunks then n - k * size else size)
  tasks.map Task.get

end CompStark.Fixtures.Keccak
